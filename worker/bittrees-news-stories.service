[Unit]
Description=Bittrees public source briefings and IPFS archive
After=network-online.target
[Service]
ExecStart=/usr/bin/python3 %h/.local/lib/bittrees-news/stories.py
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/bittrees-news
UMask=0077
MemoryMax=256M
Nice=10
[Install]
WantedBy=default.target
